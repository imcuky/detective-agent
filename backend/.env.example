# Gemini API key (required for live LLM turns in CLI and web UI)
GEMINI_API_KEY=your_gemini_api_key_here

# Fast default Gemini model for DM orchestrator and NPC subagents
GEMINI_MODEL_DM=gemini-2.5-flash
GEMINI_MODEL_NPC=gemini-2.5-flash

# Optional agent loop guard settings
MAX_AGENT_STEPS=6
MAX_NPC_STEPS=3
